# ──────────────────────────────────────────────────────────────────────
#  DevOps Incident Agent — Environment Configuration
#  Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────

# ── LLM (Required) ────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── GitHub Integration (Optional — needed for auto-creating issues/PRs)
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_REPO=owner/repo

# ── Telegram Notifications (Optional — needed for alert messages) ─────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/devops_agent

# ── PostgreSQL Container Settings ─────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=devops_agent

# ── Monitoring Tuning ─────────────────────────────────────────────────
LOG_POLL_INTERVAL=30
CORRELATION_WINDOW_MINUTES=15
AUTO_RESOLVE_MINUTES=30

# ── Application ───────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Log Simulator ─────────────────────────────────────────────────────
BACKEND_URL=http://backend:8000
SIMULATOR_APP_ID=
ANOMALY_RATE=0.2
INTERVAL_SECONDS=10
